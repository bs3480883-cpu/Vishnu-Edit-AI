rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Server-side SHA-256 password verification for Owner Admin login
    // Accepts SHA-256("Vishnu@2026") or SHA-256("VISHNU-EDIT-AI-OWNER-2026")
    function isValidAdminPasskeyHash(hash) {
      return hash is string && hash in [
        '98ff60b24304494ee43a8fd15620a39a3527a6753169acb2ed5a7f029ef758bc',
        '68d1ecca881466cce9ffa12b0228c885db3dbad36f3003856940d82d4b9a019c'
      ];
    }

    // Verifies that the provided sessionId exists as a server-validated AdminSession document
    function isAuthorizedAdminSession(sessionId) {
      return isValidId(sessionId) &&
             exists(/databases/$(database)/documents/admin_sessions/$(sessionId));
    }

    function isValidCategory(cat) {
      return cat is string && cat in [
        'Cinematic AI Videos',
        'Animal AI Videos',
        'Realistic AI Videos',
        '3D Animation',
        'VFX Videos',
        'AI Short Films'
      ];
    }

    // Validation Blueprint: AdminSession
    function isValidAdminSession(data, sessionId) {
      return data.sessionId is string && data.sessionId == sessionId &&
             isValidAdminPasskeyHash(data.passkeyHash) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // Validation Blueprint: VideoShowcase
    function isValidVideo(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 2000 &&
             data.videoUrl is string && data.videoUrl.size() >= 1 && data.videoUrl.size() <= 1000 &&
             data.thumbnailUrl is string && data.thumbnailUrl.size() >= 1 && data.thumbnailUrl.size() <= 1000 &&
             data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 4000 &&
             isValidCategory(data.category) &&
             data.published is bool &&
             data.featured is bool &&
             data.popularPrompt is bool &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 36000 &&
             data.aspectRatio is string && data.aspectRatio.size() >= 1 && data.aspectRatio.size() <= 20 &&
             data.aiModel is string && data.aiModel.size() >= 1 && data.aiModel.size() <= 80 &&
             data.authorId is string && data.authorId == 'vishnu_owner_studio' &&
             isValidId(data.adminSessionId) &&
             data.pendingDelete is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Validation Blueprint: SavedPrompt (Public Visitor Device Library)
    function isValidSavedPrompt(data) {
      return isValidId(data.visitorId) &&
             isValidId(data.videoId) &&
             data.videoTitle is string && data.videoTitle.size() >= 1 && data.videoTitle.size() <= 150 &&
             data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 4000 &&
             isValidCategory(data.category) &&
             data.thumbnailUrl is string && data.thumbnailUrl.size() >= 1 && data.thumbnailUrl.size() <= 1000 &&
             data.aiModel is string && data.aiModel.size() >= 1 && data.aiModel.size() <= 80 &&
             data.notes is string && data.notes.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Owner Admin Session Registry (Password-Verified on Server)
    match /admin_sessions/{sessionId} {
      allow get: if isValidId(sessionId);
      allow list: if false;
      allow create, update: if isValidId(sessionId) &&
                               incoming().keys().hasAll(['sessionId', 'passkeyHash', 'createdAt']) &&
                               incoming().keys().hasOnly(['sessionId', 'passkeyHash', 'createdAt']) &&
                               isValidAdminSession(incoming(), sessionId);
      allow delete: if isValidId(sessionId) && isAuthorizedAdminSession(sessionId);
    }

    // One-Time Studio Showcase Bootstrap Configuration
    match /studio_config/{configId} {
      allow get: if isValidId(configId);
      allow list: if false;
      allow create, update: if configId == 'bootstrap' &&
                               incoming().keys().hasAll(['seeded', 'updatedAt']) &&
                               incoming().keys().hasOnly(['seeded', 'updatedAt']) &&
                               incoming().seeded is bool &&
                               incoming().updatedAt is timestamp &&
                               incoming().updatedAt <= request.time;
      allow delete: if false;
    }

    // AI Video & Photo Showcase Collection
    match /videos/{videoId} {
      // Public visitors can read any published video without login
      allow get: if isValidId(videoId) && existing().published == true;

      // Public visitors can list published videos; Owner Admin can list all studio videos
      allow list: if existing().published == true ||
                     (existing().authorId == 'vishnu_owner_studio' &&
                      isAuthorizedAdminSession(existing().adminSessionId));

      // Only the password-authenticated Owner Admin can upload new videos
      allow create: if isValidId(videoId) &&
                       incoming().keys().hasAll([
                         'title', 'description', 'videoUrl', 'thumbnailUrl', 'prompt',
                         'category', 'published', 'featured', 'popularPrompt',
                         'durationSeconds', 'aspectRatio', 'aiModel', 'authorId',
                         'adminSessionId', 'pendingDelete', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title', 'description', 'videoUrl', 'thumbnailUrl', 'prompt',
                         'category', 'published', 'featured', 'popularPrompt',
                         'durationSeconds', 'aspectRatio', 'aiModel', 'authorId',
                         'adminSessionId', 'pendingDelete', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidVideo(incoming()) &&
                       incoming().pendingDelete == false &&
                       isAuthorizedAdminSession(incoming().adminSessionId);

      // Only the password-authenticated Owner Admin can edit, publish, unpublish, or mark for deletion
      allow update: if isValidId(videoId) &&
                       isValidVideo(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'description', 'videoUrl', 'thumbnailUrl', 'prompt',
                         'category', 'published', 'featured', 'popularPrompt',
                         'durationSeconds', 'aspectRatio', 'aiModel', 'adminSessionId',
                         'pendingDelete', 'updatedAt'
                       ]) &&
                       isAuthorizedAdminSession(incoming().adminSessionId);

      // Only videos marked pendingDelete by a verified Owner Admin session can be deleted
      allow delete: if isValidId(videoId) &&
                       existing().pendingDelete == true &&
                       isAuthorizedAdminSession(existing().adminSessionId);
    }

    // Public Visitor Saved Prompts Collection (Scoped per device visitorId, No Login Required)
    match /visitors/{visitorId}/saved_prompts/{savedId} {
      allow get: if isValidId(visitorId) &&
                    isValidId(savedId) &&
                    existing().visitorId == visitorId;

      allow list: if isValidId(visitorId) &&
                     existing().visitorId == visitorId;

      allow create: if isValidId(visitorId) &&
                       isValidId(savedId) &&
                       incoming().visitorId == visitorId &&
                       incoming().keys().hasAll([
                         'visitorId', 'videoId', 'videoTitle', 'prompt', 'category',
                         'thumbnailUrl', 'aiModel', 'notes', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'visitorId', 'videoId', 'videoTitle', 'prompt', 'category',
                         'thumbnailUrl', 'aiModel', 'notes', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidSavedPrompt(incoming());

      allow update: if isValidId(visitorId) &&
                       isValidId(savedId) &&
                       isValidSavedPrompt(incoming()) &&
                       incoming().visitorId == existing().visitorId &&
                       incoming().videoId == existing().videoId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'updatedAt']);

      allow delete: if isValidId(visitorId) &&
                       isValidId(savedId) &&
                       existing().visitorId == visitorId;
    }
  }
}
